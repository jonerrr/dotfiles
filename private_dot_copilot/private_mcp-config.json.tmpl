{
  "mcpServers": {
    "context7": {
      "command": "/usr/bin/mise",
      "args": [
        "-C",
        {{ joinPath .chezmoi.homeDir ".agents" | toJson }},
        "run",
        "mcp:context7"
      ],
      "type": "local",
      "tools": [
        "*"
      ]
    },
